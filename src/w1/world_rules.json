  "rules": [
    {
      "rule_id": "R_M1_1",
      "axiom_id": "A_M1",
      "description": "combat_attack 事件的目标必须是可受伤害的实体类型（npc/player/vehicle）",
      "conditions": {
        "event_kind": "combat_attack",
        "target_kind_in": [
          "npc",
          "player",
          "vehicle"
        ]
      },
      "ground_truth": {
        "target_must_be_damagable": true,
        "excluded_kinds": [
          "device",
          "item",
          "unknown"
        ]
      },
      "verified_version": "0.5.8",
      "confidence": 0.95,
      "sample_count": 158
    },
    {
      "rule_id": "R_M1_2",
      "axiom_id": "A_M1",
      "description": "combat_attack 事件发生后，target 的 hp 应下降（hp_after < hp_before）",
      "conditions": {
        "event_kind": "combat_attack",
        "requires_hp_comparison": true
      },
      "ground_truth": {
        "hp_should_decrease": true,
        "strict": true
      },
      "verified_version": "0.5.8",
      "confidence": 0.9,
      "sample_count": 120
    },
    {
      "rule_id": "R_M1_3",
      "axiom_id": "A_M1",
      "description": "实体 hp 下限为 0，不可为负数",
      "conditions": {
        "entity_field": "hp",
        "constraint": "min"
      },
      "ground_truth": {
        "hp_min": 0,
        "allow_negative": false
      },
      "verified_version": "0.5.8",
      "confidence": 1.0,
      "sample_count": 500
    },
    {
      "rule_id": "R_M1_4",
      "axiom_id": "A_M1",
      "description": "不同 kind 的实体 HP 上限不同：player/npc 上限 100，vehicle 上限 1000，device/item 无 hp",
      "conditions": {
        "entity_field": "hp",
        "constraint": "max_by_kind"
      },
      "ground_truth": {
        "hp_max": {
          "player": 100,
          "npc": 100,
          "vehicle": 1000,
          "device": 0,
          "item": 0,
          "unknown": 100
        }
      },
      "verified_version": "0.5.8",
      "confidence": 0.85,
      "sample_count": 80
    },
    {
      "rule_id": "R_M1_5",
      "axiom_id": "A_M1",
      "description": "combat_attack 的目标不得为非敌对平民（labels 含 civilian 且不含 hostile）——误伤平民为违规（S29.5 planner 批次补全的世界规则，让攻击目标选择的因果语义可判定）",
      "conditions": {
        "event_kind": "combat_attack",
        "target_labels_exclude": [
          "hostile"
        ],
        "target_labels_require": [
          "civilian"
        ]
      },
      "ground_truth": {
        "civilian_attack_is_violation": true
      },
      "verified_version": "mock",
      "confidence": 1.0,
      "sample_count": 0
    },
    {
      "rule_id": "R_W2_1",
      "axiom_id": "A_W2_5",
      "description": "hp <= 0 时，该实体应触发 entity_death 事件",
      "conditions": {
        "entity_hp": "<=0",
